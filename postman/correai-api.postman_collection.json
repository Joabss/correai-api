{
  "info": {
    "name": "correai-api",
    "description": "Collection completa da API correai-api. Aplicativo de corrida/caminhada onde o usuário registra atividades e consulta estatísticas de desempenho.\n\nA autenticação usa um JWT emitido pela API: execute primeiro `Auth > Criar usuário anônimo`, que salva o token na variável `accessToken`. As demais requests enviam `Authorization: Bearer {{accessToken}}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b6f6a1a0-1e9a-4b7a-9a1a-correai0001"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT retornado por POST /auth/anonymous (preenchido automaticamente)."
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "Refresh token de uso único (preenchido automaticamente por anonymous, login, criar usuário e refresh)."
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string",
      "description": "Token de recuperação de senha (colar manualmente; em dev aparece no log com app.security.password-reset.log-token=true)."
    },
    {
      "key": "activityId",
      "value": "",
      "type": "string",
      "description": "UUID de uma atividade criada, usado em requests futuras caso a API venha a expor endpoints por id."
    },
    {
      "key": "photoId",
      "value": "11111111-1111-4111-8111-111111111111",
      "type": "string",
      "description": "UUID de uma foto: use um novo UUID para adicionar outra foto; reutilize para tentar novamente."
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "UUID do usuário, preenchido automaticamente por POST /auth/anonymous."
    },
    {
      "key": "goalId",
      "value": "",
      "type": "string",
      "description": "UUID de uma meta (preenchido ao criar a meta de distância)."
    },
    {
      "key": "activityId",
      "value": "",
      "type": "string",
      "description": "UUID de uma atividade."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Criar usuário anônimo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.collectionVariables.set('userId', json.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/anonymous",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "anonymous"
              ]
            },
            "description": "Cria um usuário anônimo e retorna um JWT (Bearer). O token é salvo automaticamente na variável accessToken."
          },
          "response": []
                    },
                    {
                      "name": "Login",
                      "event": [
                        {
                          "listen": "test",
                          "script": {
                            "exec": [
                              "const json = pm.response.json();",
                              "pm.collectionVariables.set('accessToken', json.accessToken);",
                              "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                              "pm.collectionVariables.set('userId', json.userId);"
                            ],
                            "type": "text/javascript"
                          }
                        }
                      ],
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"senha-segura-123\"\n}"
                        },
                        "url": {
                          "raw": "{{baseUrl}}/auth/login",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "auth",
                            "login"
                          ]
                        },
                        "description": "Autentica um usuário cadastrado por e-mail e senha e retorna um JWT (Bearer). 401 se as credenciais forem inválidas. O token, o refreshToken e o userId são salvos automaticamente."
                      },
                      "response": []
                                            },
                                            {
                                              "name": "Refresh token",
                                              "event": [
                                                {
                                                  "listen": "test",
                                                  "script": {
                                                    "exec": [
                                                      "const json = pm.response.json();",
                                                      "pm.collectionVariables.set('accessToken', json.accessToken);",
                                                      "pm.collectionVariables.set('refreshToken', json.refreshToken);"
                                                    ],
                                                    "type": "text/javascript"
                                                  }
                                                }
                                              ],
                                              "request": {
                                                "method": "POST",
                                                "header": [
                                                  {
                                                    "key": "Content-Type",
                                                    "value": "application/json"
                                                  }
                                                ],
                                                "body": {
                                                  "mode": "raw",
                                                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                                                },
                                                "url": {
                                                  "raw": "{{baseUrl}}/auth/refresh",
                                                  "host": [
                                                    "{{baseUrl}}"
                                                  ],
                                                  "path": [
                                                    "auth",
                                                    "refresh"
                                                  ]
                                                },
                                                "description": "Troca o refresh token (uso único) por um novo JWT e um novo refresh token. 401 se for inválido, expirado ou já usado."
                                              },
                                              "response": []
                                            },
                                            {
                                              "name": "Recuperar senha - solicitar",
                                              "request": {
                                                "method": "POST",
                                                "header": [
                                                  {
                                                    "key": "Content-Type",
                                                    "value": "application/json"
                                                  }
                                                ],
                                                "body": {
                                                  "mode": "raw",
                                                  "raw": "{\n  \"email\": \"ana@example.com\"\n}"
                                                },
                                                "url": {
                                                  "raw": "{{baseUrl}}/auth/password-reset/request",
                                                  "host": [
                                                    "{{baseUrl}}"
                                                  ],
                                                  "path": [
                                                    "auth",
                                                    "password-reset",
                                                    "request"
                                                  ]
                                                },
                                                "description": "Solicita a recuperação de senha. Sempre retorna 202, exista o e-mail ou não."
                                              },
                                              "response": []
                                            },
                                            {
                                              "name": "Recuperar senha - confirmar",
                                              "request": {
                                                "method": "POST",
                                                "header": [
                                                  {
                                                    "key": "Content-Type",
                                                    "value": "application/json"
                                                  }
                                                ],
                                                "body": {
                                                  "mode": "raw",
                                                  "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"nova-senha-123\"\n}"
                                                },
                                                "url": {
                                                  "raw": "{{baseUrl}}/auth/password-reset/confirm",
                                                  "host": [
                                                    "{{baseUrl}}"
                                                  ],
                                                  "path": [
                                                    "auth",
                                                    "password-reset",
                                                    "confirm"
                                                  ]
                                                },
                                                "description": "Define a nova senha (8-72 caracteres) com o token recebido. 204 em sucesso; 400 senha inválida; 401 token inválido/expirado. Revoga todos os refresh tokens do usuário."
                                              },
                                              "response": []
                                            }
                  ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Criar usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.collectionVariables.set('userId', json.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"senha-segura-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Cadastra um usuário com nome, e-mail e senha (8-72 caracteres) e retorna um JWT (Bearer). 409 se o e-mail já existir. O token e o userId são salvos automaticamente."
          },
          "response": []
        },
        {
          "name": "Usuário autenticado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Retorna o usuário dono do token atual (id, name, email, anonymous, createdAt).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Converter em conta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"senha-segura-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/me/account",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me",
                "account"
              ]
            },
            "description": "Converte o usuário autenticado (anônimo ou legado só com nome) em conta com e-mail e senha, mantendo o histórico. 409 se já tiver conta ou o e-mail já existir.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Activities",
      "item": [
        {
          "name": "Listar atividades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/activities?page=0&size=20",
              "host": [
