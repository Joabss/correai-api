            "description": "Lista paginada das atividades do usuário autenticado (ordenadas da mais recente para a mais antiga).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Criar atividade (RUN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set('activityId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RUN\",\n  \"distanceKm\": 5.2,\n  \"durationSeconds\": 1500,\n  \"startedAt\": \"2026-11-27T22:00:00-03:00\",\n  \"trainingType\": \"EASY\",\n  \"perceivedEffort\": \"OK\",\n  \"notes\": \"Treino leve de recuperação\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activities"
              ]
            },
            "description": "Cria uma nova atividade do tipo corrida (RUN).\n\nCampos:\n- type: RUN | WALK (obrigatório)\n- distanceKm: número > 0 (obrigatório)\n- durationSeconds: número > 0 (obrigatório)\n                        - startedAt: data/hora ISO 8601 com offset local do usuário (opcional; sem offset e omissão usam São Paulo)\n- trainingType: EASY | TEMPO | INTERVAL | LONG (opcional)\n- perceivedEffort: EASY | OK | HARD (opcional)\n- notes: texto livre (opcional)",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Criar atividade (WALK)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"WALK\",\n  \"distanceKm\": 3.0,\n  \"durationSeconds\": 2400,\n  \"trainingType\": \"EASY\",\n  \"perceivedEffort\": \"EASY\",\n  \"notes\": \"Caminhada tranquila no parque\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/activities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "activities"
              ]
            },
            "description": "Cria uma nova atividade do tipo caminhada (WALK).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
