    {
      "name": "Perfil e arquivos",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{accessToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Alterar perfil",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana@example.com\",\n  \"currentPassword\": \"senha-atual\"\n}"
            },
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Enviar foto de perfil",
          "request": {
            "method": "PUT",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/users/me/photo"
          }
        },
        {
          "name": "Consultar foto de perfil",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me/photo" }
        },
        {
          "name": "Editar atividade",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RUN\",\n  \"distanceKm\": 5.0,\n  \"durationSeconds\": 1800,\n  \"trainingType\": \"EASY\",\n  \"perceivedEffort\": \"OK\",\n  \"notes\": \"Atividade corrigida\"\n}"
            },
            "url": "{{baseUrl}}/activities/{{activityId}}",
            "description": "Atualiza os campos informados da atividade do usuario autenticado; type, distanceKm e durationSeconds sao obrigatorios. Treino, esforco e notas omitidos ou nulos sao removidos. Preserva inicio, fotos e percurso e recalcula pace."
          }
        },
        {
          "name": "Enviar foto de atividade",
          "request": {
            "method": "PUT",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/activities/{{activityId}}/photo"
          }
        },
        {
          "name": "Consultar foto de atividade",
          "request": { "method": "GET", "url": "{{baseUrl}}/activities/{{activityId}}/photo" }
        },
        {
          "name": "Listar fotos de atividade",
          "request": { "method": "GET", "url": "{{baseUrl}}/activities/{{activityId}}/photos" }
        },
        {
          "name": "Enviar foto individual de atividade",
          "request": {
            "method": "PUT",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/activities/{{activityId}}/photos/{{photoId}}"
          }
        },
        {
          "name": "Consultar foto individual de atividade",
          "request": { "method": "GET", "url": "{{baseUrl}}/activities/{{activityId}}/photos/{{photoId}}" }
        },
        {
          "name": "Apagar foto individual de atividade",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/activities/{{activityId}}/photos/{{photoId}}",
            "description": "Remove apenas a foto indicada. Exige propriedade da atividade; repetir a exclusao retorna 204. Use activityId como photoId para apagar a foto legada."
          }
        },
        {
          "name": "Enviar percurso GPX",
          "request": {
            "method": "PUT",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
            "url": "{{baseUrl}}/activities/{{activityId}}/route"
          }
        },
        {
          "name": "Consultar percurso GPX",
          "request": { "method": "GET", "url": "{{baseUrl}}/activities/{{activityId}}/route" }
        }
      ],
      "description": "Requisições autenticadas. Selecione um arquivo nos envios. Perfil, percurso e foto legada substituem o arquivo anterior. Para várias fotos, use photos/{photoId} com UUID diferente por foto; repetir o mesmo UUID substitui apenas essa foto. A lista inclui a foto legada, identificada pelo UUID da atividade."
    },
